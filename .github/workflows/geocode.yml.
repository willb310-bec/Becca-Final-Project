name: Geocode resources
on: workflow_dispatch

jobs:
  geocode:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install requests openpyxl
      - run: python geocode_resources.py BKCB16_Resources.xlsx
      - uses: actions/upload-artifact@v4
        with:
          name: geocoded
          path: |
            BKCB16_Resources_geocoded.xlsx
            BKCB16_Resources_geocoded.csv
